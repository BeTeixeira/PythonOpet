{
  "expo": {
    "name": "GameStar",
    "slug": "gamestar-app",
    "scheme": "gamestar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.gamestar.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
